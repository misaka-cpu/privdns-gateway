[Unit]
Description=PrivDNS Gateway :81 探测端点 (Android/iOS 公共; GET / -> HTTP 200)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/pdg-bot/probe81.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
DynamicUser=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
# 会话状态的唯一落点。DynamicUser 隐含 ProtectSystem=strict, 没有这两行的话服务
# 一个字节都写不了。tmpfs + 服务停止即销毁, 正好匹配「会话不跨重启存活」。
# 0700: 属主是那个动态 UID, 别的非 root 用户读不到 token 摘要。
RuntimeDirectory=pdg-probe81
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
