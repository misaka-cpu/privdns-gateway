# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# pdg 运行期数据 (对应 /var/lib/pdg, /var/log/pdg)
/var/
*.log

# 生成的配置产物 (本地试编译时)
/out/
*.generated.lua
*.generated.json

# 机密: 真实 IP / 密码 / 证书不要进版本库
config/pdg.local.conf
*.pem
*.key
tls/

# 测试用钉死版内核(prepare-mihomo.sh 下载并校验 SHA256 后放这儿, 不入库)
tests/.bin/

# Claude Code 的 worktree 挂在这里。它们是**独立的 git 检出**, 绝不能进版本库 ——
# `git add -A` 会把它们当成嵌入仓库收进去, 而克隆方拿到的是三个空目录。
.claude/
